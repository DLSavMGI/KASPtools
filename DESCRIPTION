Encoding: UTF-8
Depends: R (>= 4.1.0)
Imports:
    dplyr,
    ggplot2,
    htmlwidgets,
    openxlsx,
    plotly,
    purrr,
    tibble,
    tidyr,
    xml2
RoxygenNote: 7.3.2
